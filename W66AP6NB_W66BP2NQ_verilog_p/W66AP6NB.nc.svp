    Either LPR4 or LPR4X must be defined. // Compiler's ERROR if not defined.
    ;
  `endif

`ifdef MEM_FILE
  int memfd_lb [(1<<`bank_wid)-1:0], memfd_ub [(1<<`bank_wid)-1:0];
`else
  logic[`io_wid-1:0] lpddr_array[int unsigned];
`endif  

  initial begin
      cmd_string[C_ACT_CMD]                 = "C_ACT_CMD";
      cmd_string[C_READ_CMD]                = "C_READ_CMD";
      cmd_string[C_WRITE_CMD]               = "C_WRITE_CMD";
      cmd_string[C_WRITE_AP_CMD]            = "C_WRITE_AP_CMD";
      cmd_string[C_READ_AP_CMD]             = "C_READ_AP_CMD";
      cmd_string[C_MPC_CMD]                 = "C_MPC_CMD";
      cmd_string[C_MRR_CMD]                 = "C_MRR_CMD";
      cmd_string[C_MRW_CMD]                 = "C_MRW_CMD";
