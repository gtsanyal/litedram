      cmd_string[C_REF_CMD]                 = "C_REF_CMD";
      cmd_string[C_MASK_WRITE_CMD]          = "C_MASK_WRITE_CMD";
      cmd_string[C_SRE_CMD]                 = "C_SRE_CMD";
      cmd_string[C_SRX_CMD]                 = "C_SRX_CMD";
      cmd_string[C_MPC_WR_FIFO_CMD]         = "C_MPC_WR_FIFO_CMD";
      cmd_string[C_MPC_RD_FIFO_CMD]         = "C_MPC_DQS_START_OSCI_CMD";
      cmd_string[C_MPC_DQS_STOP_OSCI_CMD]   = "C_MPC_DQS_STOP_OSCI_CMD";
      cmd_string[C_MPC_DQ_CALIB_CMD]        = "C_MPC_DQ_CALIB_CMD";
      cmd_string[C_CAS2_CMD]                = "C_CAS2_CMD";
  
      cmd_1st_cycle_string[C_ACT_1st_CMD]                 = "C_ACT_1st_CMD";
      cmd_1st_cycle_string[C_READ_1st_CMD]                = "C_READ_1st_CMD";
      cmd_1st_cycle_string[C_WRITE_1st_CMD]               = "C_WRITE_1st_CMD";
      cmd_1st_cycle_string[C_MPC_1st_CMD]                 = "C_MPC_1st_CMD";
      cmd_1st_cycle_string[C_MRR_1st_CMD]                 = "C_MRR_1st_CMD";
