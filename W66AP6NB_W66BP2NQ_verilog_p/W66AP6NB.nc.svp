// ************************* READ ME  *********************************************************
// --------------------------------------------------------------------------------------------
// File included
// --------------------------------------------------------------------------------------------
//    Config-AC.v (all AC/DC parameters used by the model)
// 
// --------------------------------------------------------------------------------------------
// Define options
// --------------------------------------------------------------------------------------------
//    T1600, T2400, T2667, T3200, T3733, T4267: speed grade (data rate)
//    MEM_FILE      : use file for memory storage 
//    MEM_INIT      : pre load memory at beginning of simulation
//                    file name: mem_init.txt
//                    file format: address data    // ascii hex
//    WEC_DIS_INFO  : to suppress INFO message
//    WEC_DIS_ERR   : to suppress ERROR message
//    WEC_DIS_WARN  : to suppress WARNING message
//
//    DSPH          : to display module hierarchy  
// --------------------------------------------------------------------------------------------
// API
// --------------------------------------------------------------------------------------------
//  - To dump memory content 
//      function automatic void mem_dump(input logic [ADDR_BITS-1:0] start=0, input int len=0);
//  - Store one word to a memory address
//      function automatic void store_word_to_mem(input logic [ADDR_BITS-1:0] addr, input logic [`io_wid:0] data);
//
// --------------------------------------------------------------------------------------------
// Simulator run
// --------------------------------------------------------------------------------------------
//    ncverilog +access+rwc +sv +define+T1600 MODEL_FILE_NAME ....
//    vcs -V -notice -full64 -debug_access+all -sverilog -R +define+T1600 MODEL_FILE_NAME ....
//    vlog -sv -sv09compat +define+T1600 MODEL_FILE_NAME
//    Please reference file "runsim_readme.txt"
//--------------------------------------------------------------------------
//                Simulation Option
//--------------------------------------------------------------------------
//
//   Write data input timing  :
//  
//  (1) Write parameter of verilog model
//    - This verilog model default tDQSS parameter is 1*tCK.
//    - This verilog model default tDQS2DQ parameter is 0.5ns.
//  
//  (2) Parameter change ( Only tDQS2DQ is allowed.)
//     - If you need to change write parameter,
//       please attach the option shown below.
//  example) ncverilog  +define+tDQS2DQ=0.400  your_system.v   - Please keep tDQS2DQ timing.
//  
//  
//  MR18 and MR19 (IT-LSB, IT-MSB) :
//     Osc_count[15:0] = Runtime/(2*tDQS2DQ)
//     MR18 =  Osc_count[7:0]
//     MR19 =  Osc_count[15:8]
//        - This verilog model default tDQS2DQ parameter is 0.5ns. 
// --------------------------------------------------------------------------------------------
// Features not supported:
// --------------------------------------------------------------------------------------------
//  (1) Functions not supported 
//      - ODT function
//      - Post-Package repair function
//      - Target row refresh
// 
//  (2) AC timing check not supported
//      - CA bus training parameters (tCKELODTon, tCKELODToff)
//      - Write leveling parameters (tWLIVW)
//      - Asynchronous ODT turn on and turn off timing
//      - Target row refresh timing   
//      - WDQS_on/off
//      - Valid clock requirement at FSP change: tCKFSPE, tCKFSPX, tCKFSPE_SE, tCKFSPX_SE
//     
//  (3) MRR does not support DBI function
// 
// ********************************************************************************************** /   
timeunit 1ps; timeprecision 1ps;

 
// DO NOT MANUALLY EDIT THE FOLLOWING OPTIONS
// ---- LPDDR4 VER ----
`define LPR4
//`define LPR4X
//`define ALERT_PIN
//`define SCLS

module W66AP6NB (ck, ck_n, cke, cs_n, ca, odt_ca, dq, dqs, dqs_n, dmi, reset_n, zq
);

`include "Config-AC.v"
//  DIR           WIDTH          PORT NAME
    input                        ck;
    input                        ck_n;
    input                        cke;
    input                        cs_n;
    input         [`ca_wid-1:0]  ca;
    inout         [`dmi_wid-1:0] dmi;
    input                        reset_n;
    inout         [`io_wid-1:0]  dq;
    inout        [`dqs_wid-1:0]  dqs;
    inout        [`dqs_wid-1:0]  dqs_n;
    input                        odt_ca;
    input                        zq;

//

//`define DSPH

`define INFO(A) \
  do begin \
    `ifdef WEC_DIS_INFO \
      ; \
    `else \
      `ifdef DSPH $display("%m: time %0t:INFO:   %s", $time, $sformatf A, ); `else $display("time %0t:INFO:   %s", $time, $sformatf A, ); `endif \
    `endif \
  end while(0)

`define ERROR(A) \
  do begin \
    `ifdef WEC_DIS_ERR \
      errors = errors + 1; \
    `else \
      `ifdef DSPH $display("%m: time %0t:ERROR:   %s", $time, $sformatf A, ); `else $display("time %0t:ERROR:   %s", $time, $sformatf A, ); `endif \
      errors = errors + 1; \
      if (STOP_ON_ERROR) STOP(); \
    `endif \
  end while(0)

`define WARN(A) \
  do begin \
    `ifdef WEC_DIS_WARN \
      warnings = warnings + 1; \
    `else \
      `ifdef DSPH $display("%m: time %0t:WARN:   %s", $time, $sformatf A, ); `else $display("time %0t:WARN:   %s", $time, $sformatf A, ); `endif \
      warnings = warnings + 1; \
    `endif \
  end while(0)
  

  parameter bit [1:0] SCL = 2'b00;
  real  op_frequency, tRPST=0;

  time  tck_i=1250, prev_tck_i, tFAW_spec, t_clk_change, t_self_refresh_entry, t_self_refresh_exit,
        t_clk_changed_stop_start_pos, t_clk_changed_stop_start_neg, t_clk_changed_stop_end_pos, t_clk_changed_stop_end_neg,
        tm_ca_change_time, tm_ref, tm_ab_ref, tm_act, tm_precharge_all, tm_ck_pos, tm_ck_neg, tm_precharge,
        tm_reset_go_low, tm_reset_go_high, tm_cke_go_low, tm_cke_go_high,
        t_dqs1_posedge, t_dqs0_posedge, t_dqs1_negedge, t_dqs0_negedge, t_mr12_vref_ca_set_start, t_spec_tvref_ca_time,
        t_mr13_vrcg_enable, t_mr13_vrcg_disable, t_mr13_fsp_change_start, t_spec_fsp_ca_change, t_spec_fsp_dq_change, 
        t_mr13_cbt_enable, t_cbt_dqs_latch, t_cbt_dqs_latch_spec, t_cbt_cke_low_time, t_cbt_cke_high_time, t_cbt_dq_changed_time,
        t_dqs0_trans, cal_tck_p, t_cbt_valid_cmd_latch, t_mr14_vref_dq_set_start, t_spec_tvref_dq_time, dly,
        t_mrw2_end, t_mrr_cas2_end, t_read_cas2_end, t_write_cas2_end, t_mask_write_cas2_end, t_mpc_dqs_osc_start, t_mpc_dqs_osc_stop,
        t_mpc_zq_cal_start, t_mpc_zq_latch_start, t_read_to_powdn_spec, t_mrr_to_powdn_spec, t_write_to_powdn_spec, clk_abs_diff;    

  time  tm_bank_act [(1<<`bank_wid)-1:0], tm_bank_ref [(1<<`bank_wid)-1:0], tRRD_t;
     
  int unsigned rdqsen_cntr, rdqs_pre_cntr, rdqs_pst_cntr, rdata_cntr, ck_cntr, ck_ab_ref, ck_pb_ref, ck_act, ck_pre, ck_prea,
        ck_self_refresh_entry, ck_self_refresh_exit, ck_tRPST_spec, RTP_spec, tXCBT_SPEC, mpc_dqs_osc_stop, ck_cbt_valid_cmd_latch,
        cntr_clk_change, cntr_mrw2_end_prev, cntr_mrw2_end, cntr_mrw2_cs_high, cntr_mrr_cas2_end, cntr_read_cas2_end, cntr_write_cas2_end,
        cntr_mask_write_cas2_end, cntr_mpc_dqs_osc_start, cntr_changed_OK, cntr_mpc_dqs_osc_stop, cntr_mpc_write_fifo_end,
        cntr_mpc_read_fifo_end, cntr_mpc_read_dq_calib_end, spec_tRTW, spec_tWRWTR, spec_tWRMPCCALIB, spec_tRTRRD,
        warnings, errors, tmpj, tFC_item, tFC_DQ_item, ck_n_toggle, wdqs_n_toggle, ODTLON, ODTLOFF;

  int unsigned ck_bank_act [(1<<`bank_wid)-1:0], ck_bank_write [(1<<`bank_wid)-1:0],
        ck_bank_read [(1<<`bank_wid)-1:0], ck_bank_pre [(1<<`bank_wid)-1:0],
        ck_bank_mask_write[(1<<`bank_wid)-1:0];



  int unsigned read_bank_bl [(1<<`bank_wid)-1:0]; //2022.08.12 for read cmd to precharge cmd for different bank timing cheking



  string cmd_string [int], cmd_1st_cycle_string [int], tmp_model_dir;

  bit pwr_cold_up=1, ck_changed, ck_changed_OK, fsp_op_changed, flag_clk_changed_stop_start_1st, ck_jit_err,
      first_wl_arrive, dbi_read_true, dbi_read_high_true, dbi_read_low_true,
      first_read_cmd=1, ca_odt_rzq_en, dq_odt_rzq_en, init_done, fisrt_cbt_dqs, flag_tCKELCK_tck, dq_rpt, in_self_refresh,
      self_refresh_entry, cbt_en_enter, cbt_exit, cbt_en_real_enter, dqsin_pos_en_delay,
      dqs_out_en, dqs_out=1, dqs_pre_out, dqs_pst_out, dq_out_en, dq_lb_out_en, dq_ub_out_en,
      dmi0_out_en, dmi1_out_en, f_dqs_osc, mpc_cmd_1st, precharge_cmd_1st, refresh_cmd_1st, selfrefresh_enter_cmd_1st, 
      write1_cmd_1st, selfrefresh_exit_cmd_1st, mask_write1_cmd_1st, read1_cmd_1st, cas2_cmd_1st, mode_register_write1_cmd_1st,
      mode_register_write2_cmd_1st, mode_register_read1_cmd_1st, active1_cmd_1st, active2_cmd_1st,
      f_mpc_cmd, f_precharg_cmd, f_ref_cmd, f_self_ref_entry_cmd, f_self_ref_exit_cmd, f_write_cmd, f_mask_write_cmd,
      f_read_cmd, f_mrw_cmd, f_mrr_cmd, f_active_cmd, f_valid_cmd, f_complete_cmd, f_1cmd_set_complete_cmd,
      precharge_allbank, precharge_perbank, ref_allbank, ref_per_bank, read_burst_len_bit,
      mem_write_change, mem_write_lb_change, mem_write_ub_change, write_auto_pre, read_auto_pre, read_data_start, read_dqs_start, f_ca_check_cshigh,f_ca_check_cslow;
  
  logic [2:0] active_bank, precharge_bank, ref_bank, mem_write_ub_bank, mem_write_lb_bank, mem_write_bank_tmp, mem_read_bank, wr_ptr, rd_ptr;

  logic [5:0] ma, prev_cmd, current_cmd, current_1st_cycle_cmd, compre_write_real_bl, write_real_bl, prev_write_real_bl,
              read_real_bl, prev_read_real_bl, cbt_valid_op, init, final_read_real_bl, final_read_cmd, final_write_cmd, final_write_cmd0,
              mem_write_real_bl_tmp, mem_write_cntr, mem_write_ub_cntr, mem_write_lb_cntr;

  logic [5:0] write_cmd_pipeline [MAX_PIPE:0], read_cmd_pipeline [MAX_PIPE:0], read_bl_pipeline [MAX_PIPE:0], write_bl_pipeline [MAX_PIPE:0];
  logic [MAX_PIPE:0] wr_pipeline, rd_pipeline;
  logic [9:0] ma_pipeline [MAX_PIPE:0];
  logic [`bank_wid+5:0] ba_pipeline [MAX_PIPE:0];
  logic [`row_wid-1:0]  row_pipeline [MAX_PIPE:0];
  logic [`col_wid-1:0]  write_col_pipeline [MAX_PIPE:0], read_col_pipeline [MAX_PIPE:0];

  logic [6:0] mpc_op; 
  logic [7:0] mr_latch, mrw_op;
  logic [7:0] mr [MR_ID_MAX:0], prev_mr[MR_ID_MAX:0];         // mode register
  logic [7:0] fsp0_mr [MR_ID_MAX:0], fsp1_mr [MR_ID_MAX:0];   // mode register for fsp0/1
  logic [15:0] mpc_dqs_osc_duration=0, mpc_read_pattern, dq_in_pos;
  logic [32*6-1:0] fifo_dmi_high, fifo_dmi_low;
  logic [`io_wid-1:0] fifo_memory[32*6-1:0];
  logic [`io_wid-1:0] dq_out, dq_in, dq_temp;
  logic [`ca_wid-1:0] ca_q;

  logic [(1<<`bank_wid)-1:0] write_ba, mask_write_ba, read_ba, auto_precharge_bank, write_precharge_bank, read_precharge_bank,
                             write_precharge_bank_trp_ready, read_precharge_bank_trp_ready, bank_active, bank_perbank_refresh;

  logic [`row_wid-1:0] row_addr, mem_write_ub_row, mem_write_lb_row, mem_write_row_tmp, mem_read_row;
  logic [`col_wid-1:0] col_addr, mem_write_ub_col, mem_write_lb_col, mem_write_col_tmp, mem_read_col;

  bit [`bank_wid:0] bank_counter;
  bit [`dmi_wid-1:0] dmi_out;

  logic [`row_wid-1:0] row_active [(1<<`bank_wid)-1:0];

  logic [`dqs_wid-1:0] dqs_pos_delay, dqs_even;
  logic dqs_dly_out, m_clk;

  bit  FSP_OP, rdqs_se2df, rdqs_df2se, wdqs_se2df, wdqs_df2se, clk_se2df, clk_df2se, mr51_df_se, rdqs_df_mode=1, wdqs_df_mode=1, clk_df_mode=1,
       ecc_error, otp_error, thm_error; 

  int unsigned tRCD_tck, tRRD_tck, tRAS_min_tck, tRAS_max_tck, tRC_tck, tRPpb_tck, tRPab_tck, tOSCO_tck, tCKFSPX_tck, tMRD_tck,
              tRTP_tck, tRP_ALL_tck, tRP_PER_tck,tWR_tck, tZQLAT_tck, tCMDCKE_tck, tMRWCKEL_tck, tZQCKE_tck, tCKE_tck, tXP_tck,
              tWTR_tck, tRFCab_tck, tRFCpb_tck, tMRRI_tck, tMPCWR_tck, tSDO_tck, tCACD_tck, tMRW_tck, tXSR_tck, tSR_tck, tCKELCK_tck,
              tCKEHCS_tck, tESCKE_tck;

  //MR vars
  logic [5:0] bl, nwr, rl, wl, vrefca, vrefdq;
  bit  bl_otf, write_leveling, dbi_read, dbi_write, dq_odt_en, ca_odt_en, vrefca_range, dm_dis, vrefdq_range, write_cmd;
  logic [4:0] nRTP;
  logic [5:0] MR1_nWRA  [8] = '{6, 10, 16, 20, 24, 30, 34, 40};
  logic [4:0] MR2_nRTPA [8] = '{8, 8, 8, 8, 10, 12, 14, 16};
  logic [5:0] MR2_WLA [16] = '{4, 6, 8, 10, 12, 14, 16, 18, 4, 8, 12, 18, 22, 26, 30, 34};
  string MR2_SET;
  string MR3_PDDSA [8] = '{"Reserved", "RZQ/1", "RZQ/2", "RZQ/3", "RZQ/4", "RZQ/5", "RZQ/6", "Reserved"};
  string MR4_RFRA [8] = '{ "SDRAM Low temperature operating limit exceeded.", "4x refresh", "2x refresh", "1x refresh", 
                          "0.5x refresh", "0.25x refresh, no de-rating", "0.25x refresh, with de-rating", 
                          "SDRAM High temperature operating limit exceeded"};
  string MR11_ODTA [8] = '{"Disable", "RZQ/1", "RZQ/2", "RZQ/3", "RZQ/4", "RZQ/5", "RZQ/6", "Reserved"};

// ---- Feature options ----
//`define RDQS_SE_LOW     // Single Ended Mode RDQS Drives Low
//`define MRR_DBI         // Not supported feature
