  `define ALERT_FEATURE   // support of ALERT PIN and MR31 for auto grade
`endif

  `ifdef LPR4
  `elsif LPR4X
  `else
    Either LPR4 or LPR4X must be defined. // Compiler's ERROR if not defined.
    ;
  `endif

`ifdef MEM_FILE
  int memfd_lb [(1<<`bank_wid)-1:0], memfd_ub [(1<<`bank_wid)-1:0];
`else
  logic[`io_wid-1:0] lpddr_array[int unsigned];
`endif  

  initial begin
      cmd_string[C_ACT_CMD]                 = "C_ACT_CMD";
      cmd_string[C_READ_CMD]                = "C_READ_CMD";
      cmd_string[C_WRITE_CMD]               = "C_WRITE_CMD";
      cmd_string[C_WRITE_AP_CMD]            = "C_WRITE_AP_CMD";
      cmd_string[C_READ_AP_CMD]             = "C_READ_AP_CMD";
      cmd_string[C_MPC_CMD]                 = "C_MPC_CMD";
      cmd_string[C_MRR_CMD]                 = "C_MRR_CMD";
      cmd_string[C_MRW_CMD]                 = "C_MRW_CMD";
      cmd_string[C_PRE_CMD]                 = "C_PRE_CMD";
      cmd_string[C_REF_ALL_BANK_CMD]        = "C_REF_ALL_BANK_CMD";
      cmd_string[C_REF_PER_BANK_CMD]        = "C_REF_PER_BANK_CMD";
      cmd_string[C_REF_CMD]                 = "C_REF_CMD";
      cmd_string[C_MASK_WRITE_CMD]          = "C_MASK_WRITE_CMD";
      cmd_string[C_SRE_CMD]                 = "C_SRE_CMD";
      cmd_string[C_SRX_CMD]                 = "C_SRX_CMD";
      cmd_string[C_MPC_WR_FIFO_CMD]         = "C_MPC_WR_FIFO_CMD";
      cmd_string[C_MPC_RD_FIFO_CMD]         = "C_MPC_DQS_START_OSCI_CMD";
      cmd_string[C_MPC_DQS_STOP_OSCI_CMD]   = "C_MPC_DQS_STOP_OSCI_CMD";
      cmd_string[C_MPC_DQ_CALIB_CMD]        = "C_MPC_DQ_CALIB_CMD";
      cmd_string[C_CAS2_CMD]                = "C_CAS2_CMD";
  
      cmd_1st_cycle_string[C_ACT_1st_CMD]                 = "C_ACT_1st_CMD";
      cmd_1st_cycle_string[C_READ_1st_CMD]                = "C_READ_1st_CMD";
      cmd_1st_cycle_string[C_WRITE_1st_CMD]               = "C_WRITE_1st_CMD";
      cmd_1st_cycle_string[C_MPC_1st_CMD]                 = "C_MPC_1st_CMD";
      cmd_1st_cycle_string[C_MRR_1st_CMD]                 = "C_MRR_1st_CMD";
      cmd_1st_cycle_string[C_MRW_1st_CMD]                 = "C_MRW_1st_CMD";
      cmd_1st_cycle_string[C_PRE_1st_CMD]                 = "C_PRE_1st_CMD";
      cmd_1st_cycle_string[C_REF_1st_CMD]                 = "C_REF_1st_CMD";
      cmd_1st_cycle_string[C_MASK_WRITE_1st_CMD]          = "C_MASK_WRITE_1st_CMD";
      cmd_1st_cycle_string[C_SRE_1st_CMD]                 = "C_SRE_1st_CMD";
      cmd_1st_cycle_string[C_SRX_1st_CMD]                 = "C_SRX_1st_CMD";
      cmd_1st_cycle_string[C_MPC_WR_FIFO_1st_CMD]         = "C_MPC_WR_FIFO_1st_CMD";
      cmd_1st_cycle_string[C_MPC_RD_FIFO_1st_CMD]         = "C_MPC_DQS_START_OSCI_1st_CMD";
      cmd_1st_cycle_string[C_MPC_DQS_STOP_OSCI_1st_CMD]   = "C_MPC_DQS_STOP_OSCI_1st_CMD";
      cmd_1st_cycle_string[C_MPC_DQ_CALIB_1st_CMD]        = "C_MPC_DQ_CALIB_1st_CMD";
      cmd_1st_cycle_string[C_CAS2_1st_CMD]                = "C_CAS2_1st_CMD";
  end

